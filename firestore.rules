rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the current user's data from the users collection
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to get the current user's gender
    function getUserGender() {
      return getCurrentUser().gender;
    }

    // users collection
    match /users/{userId} {
      allow read: if isAuthenticated()
                  && (request.auth.uid == userId || getUserGender() == resource.data.gender);
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && (request.resource.data.gender == "male" || request.resource.data.gender == "female");
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.gender == resource.data.gender;
    }

    // posts collection
    match /posts/{postId} {
      // Allow reading only if the user's gender matches the post's gender
      allow read: if isAuthenticated() && getUserGender() == resource.data.gender;
      
      // Allow creation if the user is authenticated and sets themselves as the author
      allow create: if isAuthenticated()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.gender == getUserGender()
                    && request.resource.data.postId == postId;
      
      // Allow update and delete only by the author
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // chatRooms collection
    match /chatRooms/{roomId} {
      // Allow reading if the user is a participant in the chat room
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      
      // Allow creation if the user includes themselves as a participant
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && request.resource.data.roomId == roomId;
      
      // Allow update only if the user is a participant
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.members
                    && request.resource.data.roomId == resource.data.roomId
                    && request.resource.data.members == resource.data.members;
    }

    // messages collection (subcollection of chatRooms)
    match /chatRooms/{roomId}/messages/{messageId} {
      // Allow reading if the user is a participant in the parent chat room
      allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.members;
      
      // Allow creation if the user is a participant in the parent chat room and is the sender
      allow create: if isAuthenticated() 
                    && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.members
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.messageId == messageId
                    && (request.resource.data.type == "text" || request.resource.data.type == "image");

      allow update, delete: if false;
    }
  }
}
